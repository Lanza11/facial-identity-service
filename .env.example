# --- facial-identity-service ---
# Motor: compreface | fake (simulado, para demostrar el cambio de motor)
FIS_ENGINE=compreface
# API key que deben enviar los consumidores (header x-api-key)
FIS_API_KEY=demo-key
# Umbrales de decisión sobre la similitud 0..1 del motor
FIS_MATCH_THRESHOLD=0.90
FIS_INCONCLUSIVE_THRESHOLD=0.80
FIS_MAX_ENROLLMENTS=3
FIS_MAX_FAILED_ATTEMPTS=5
FIS_LOCKOUT_MINUTES=15
FIS_IDENTIFY_CANDIDATES=3

# --- CompreFace ---
# Local: http://localhost:8000 (en docker compose se sobreescribe a http://compreface-api:8080)
COMPREFACE_URL=http://localhost:8000
# La genera scripts/bootstrap_compreface.py (o la UI de CompreFace > Application > Service)
COMPREFACE_API_KEY=
COMPREFACE_DET_PROB_THRESHOLD=0.8
# Build del modelo: 1.2.0-mobilenet (rápido) | 1.2.0 (FaceNet) | 1.2.0-arcface-r100 (preciso)
COMPREFACE_CORE_TAG=1.2.0-mobilenet
